# https://opendart.fss.or.kr 에서 발급받은 Open DART 인증키 (40자리)
DART_API_KEY=여기에_발급받은_키를_입력

# 선택 사항
KRFIN_CACHE_DIR=data/cache
KRFIN_OUT_DIR=data/out
KRFIN_RATE_LIMIT=8        # 초당 최대 요청 수
KRFIN_MAX_WORKERS=8       # 동시 요청 수
KRFIN_DAILY_QUOTA=20000   # Open DART 일일 호출 한도

# --- newsbot (부동산·경매 뉴스 메시지) ---
# https://developers.naver.com/apps 에서 '검색' API로 앱 등록 후 발급 (무료)
NAVER_CLIENT_ID=여기에_클라이언트_ID
NAVER_CLIENT_SECRET=여기에_클라이언트_시크릿
